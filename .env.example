# Copier ce fichier en `.env` (NON commité, ignoré par git) puis renseigner les valeurs.
# docker-compose lit automatiquement le fichier .env à la racine.
#
#   cp .env.example .env
#
# En dev, si .env est absent, docker-compose.yml utilise des valeurs de repli
# (syntaxe ${VAR:-défaut}) pour rester fonctionnel « out of the box ».

# Mot de passe PostgreSQL (partagé par le service db et le backend).
POSTGRES_PASSWORD=change-me-in-dev

# Clé de signature des JWT du backend. En production, générer une valeur
# aléatoire robuste, par exemple : openssl rand -hex 32
JWT_SECRET=change-me-generate-a-random-secret

# (Optionnel) Couleur du thème du frontend : blue, red, yellow, green, purple, teal.
# APP_COLOR=blue
