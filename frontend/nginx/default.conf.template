# Template traité au démarrage du conteneur par l'entrypoint nginx :
# ${BACKEND_URL} est remplacé par la variable d'environnement du même nom
# (les variables nginx comme $uri ne sont pas touchées).
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # En-têtes de sécurité de base
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Configuration runtime générée par 40-inject-env.sh — jamais mise en cache
    location = /env.js {
        alias /tmp/env.js;
        add_header Cache-Control "no-store";
    }

    # Proxy vers l'API : le front appelle /api en same-origin, pas de CORS à gérer
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Assets Vite avec hash dans le nom : cache long
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }

    # SPA : toute autre route retombe sur index.html (routing côté client)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
